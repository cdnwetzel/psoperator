#!/bin/sh
# Privacy gate on what the commit would record: the author and committer
# identity, then the staged blobs (not the working tree). An email is published
# with the commit as surely as its files. `git var` reports the identity the
# commit will carry, from the config, --author or the GIT_AUTHOR_* and
# GIT_COMMITTER_* environment. Uses the operator's private denylist when present.
# Enable once per clone: git config core.hooksPath scripts/hooks
root="$(git rev-parse --show-toplevel)"
denylist="${PRIVACY_DENYLIST:-$HOME/.config/pxx/public-denylist}"
# Each identity must resolve on its own: a failed lookup would hand the scanner
# empty input, which reads as clean. Git's own error is not shown, since it can
# carry an inferred address.
author="$(git var GIT_AUTHOR_IDENT 2>/dev/null)" || {
    echo "commit-identity: the author identity could not be resolved" >&2
    exit 1
}
committer="$(git var GIT_COMMITTER_IDENT 2>/dev/null)" || {
    echo "commit-identity: the committer identity could not be resolved" >&2
    exit 1
}
printf '%s\n%s\n' "$author" "$committer" \
    | python3 "$root/scripts/privacy_scan.py" text --name commit-identity --denylist "$denylist" \
    || exit 1
exec python3 "$root/scripts/privacy_scan.py" staged --denylist "$denylist"
